# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo (ADR-001 §10.5): padrões sem "/" inicial valem em todos os apps e pacotes.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# monorepo tooling
.turbo/
.output/
.wxt/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: segredos nunca no git; só o modelo .env.example é versionado
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
