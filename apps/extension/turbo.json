{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".output/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "env": ["TRAMPO_API_ORIGIN", "TRAMPO_SUPABASE_ORIGIN", "TRAMPO_EXTENSION_KEY", "TRAMPO_IGNORE_DOTENV"]
    },
    "test": {
      "dependsOn": ["^build", "build"]
    }
  }
}
