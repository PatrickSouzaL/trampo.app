# Variáveis do build REAL da extensão (ADR-004 D13 e §4.6; F1-EXT-06). Copie para `.env` (fora do git) e preencha.
# O build lê SÓ estas 3 chaves deste arquivo; qualquer outra é descartada. Nunca ponha aqui segredo da API
# (chave secret do Supabase, anel do envelope, chave de provedor): os 3 valores abaixo são públicos.
# Uma variável já definida no ambiente do build vence a do arquivo. Sem as três, o build sai fechado
# (connect-src 'none', sem key, login com auth_sem_configuracao).

# Origem https exata da API, sem caminho nem barra no fim (ex.: https://api.exemplo.com)
TRAMPO_API_ORIGIN=
# Origem https exata do projeto Supabase (ex.: https://<projeto>.supabase.co)
TRAMPO_SUPABASE_ORIGIN=
# Chave PÚBLICA RSA da extensão (2048 bits ou mais), SPKI DER em base64 numa linha (runbook auth-extensao §1.7)
TRAMPO_EXTENSION_KEY=
