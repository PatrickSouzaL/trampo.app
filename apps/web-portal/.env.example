# Portal do Trampo (ADR-027 D9). Lidas só no servidor, em tempo de execução (o build não lê nenhuma), validadas na
# primeira chamada e em falha fechada. Nenhum valor real neste arquivo nem no git: copie para .env.local.

# Origem exata do portal (https; http só em 127.0.0.1 ou localhost). Base do redirect_to e do Origin do logout.
PORTAL_ORIGIN=

# Origem exata do projeto Supabase (a mesma da API) e a chave PUBLISHABLE (sb_publishable_...). Secret e legada
# (eyJ...) são recusadas.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Anel do selo dos cookies: de 1 a 4 entradas kid:<32 bytes em base64url>, separadas por vírgula, com o kid em
# [a-z0-9]{1,16}, e o kid ativo. Material PRÓPRIO do portal: nunca o mesmo do AUTH_REFRESH_SEAL_KEYS da API.
# Trocar o ativo (e tirar a chave antiga) encerra todas as sessões do portal.
PORTAL_SEAL_KEYS=
PORTAL_SEAL_ACTIVE_KEY=
