# Modelo do .env da API: só NOMES. Os valores ficam no .env local (fora do git e do cofre) e no
# gerenciador de senhas. Runbook: ../base/03-infra-runbook/llm.md

# Servidor
HOST=127.0.0.1
PORT=3001

# Borda (ADR-007). Vazio = falha fechado.
# CORS_ALLOWED_ORIGINS: lista exata separada por vírgula (chrome-extension://<id de 32 letras a-p>,
# https://<origem do portal>). Sem curinga, sem barra final. Vazio nega toda origem de navegador.
CORS_ALLOWED_ORIGINS=
# TRUST_PROXY: false, ou IPs/CIDRs dos saltos de proxy reais (definidos no S-5 / ADR-003).
# Recusados: true, *, /0 e contagem de saltos.
TRUST_PROXY=false

# Cadeia de LLM das Fases 0 e 1 (HITL-012: Gemini fora da cadeia)
LLM_PROVIDER_CHAIN=groq,cloudflare_workers_ai

# Groq (ZDR ligado na organização ANTES da primeira chamada)
GROQ_API_KEY=

# Cloudflare Workers AI (token personalizado só com Workers AI Read e Edit, com TTL)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
