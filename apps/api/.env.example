# Modelo do .env da API: só NOMES. Os valores ficam no .env local (fora do git e do cofre) e no
# gerenciador de senhas. Runbook: ../base/03-infra-runbook/llm.md

# Servidor
HOST=127.0.0.1
PORT=3001

# Borda (ADR-007). Vazio = falha fechado.
# CORS_ALLOWED_ORIGINS: lista exata separada por vírgula (chrome-extension://<id de 32 letras a-p>,
# https://<origem do portal>). Sem curinga, sem barra final. Vazio nega toda origem de navegador.
CORS_ALLOWED_ORIGINS=
# TRUST_PROXY: false, ou IPs/CIDRs dos saltos de proxy reais (definidos no S-5 / ADR-003).
# Recusados: true, *, /0 e contagem de saltos.
TRUST_PROXY=false

# Cadeia de LLM das Fases 0 e 1 (HITL-012: Gemini fora da cadeia)
LLM_PROVIDER_CHAIN=groq,cloudflare_workers_ai

# Groq (ZDR ligado na organização ANTES da primeira chamada)
# Ainda não ligado no main.ts: o adapter só entra na cadeia de produção depois do aceite do p3/g4 (ADR-022).
# GROQ_API_KEY: gsk_ seguido de [A-Za-z0-9_-]{20,200}. O modelo (openai/gpt-oss-20b) e a URL são fixos no código.
GROQ_API_KEY=

# Cloudflare Workers AI (token personalizado só com Workers AI Read e Edit, com TTL)
# Ainda não ligado no main.ts: o adapter só entra na cadeia de produção depois do gate do S-1 (ADR-020 D10).
# CLOUDFLARE_ACCOUNT_ID: 32 hex minúsculos. CLOUDFLARE_API_TOKEN: [A-Za-z0-9_-]{40,200}.
# CLOUDFLARE_WORKERS_AI_MODEL: id @cf/... (provisório do ADR-020 D10: @cf/meta/llama-3.3-70b-instruct-fp8-fast).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL=

# Supabase (HITL-004, East US / us-east-1). A chave secret e a senha do banco ficam só no servidor.
# SUPABASE_URL e SUPABASE_JWKS_URL são obrigatórias (ADR-013 D6): sem elas a API não sobe. O JWKS precisa ser
# exatamente <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=
SUPABASE_JWKS_URL=
# Obrigatória (ADR-018 D5): o cliente de usuário do PostgREST usa SÓ a publishable (sb_publishable_...), com o JWT
# do próprio usuário, para a RLS valer. Chave secret (sb_secret_...) ou legada (eyJ...) aqui derruba a subida.
SUPABASE_PUBLISHABLE_KEY=
# Só o DeleteAccount (F1-PORTAL-03) a usará. Nunca na extensão, no portal ou no cliente de usuário.
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# Cifra da pretensão salarial no app (ADR-018 D4). SEGREDO, obrigatório: sem o anel a API não sobe. Fica só neste
# .env e no gerenciador de senhas; nunca no cofre, no git, no banco ou no Supabase Vault.
# CRITERIA_SALARY_KEYS: de 1 a 4 entradas <kid>:<32 bytes em base64url>, separadas por vírgula; kid em [a-z0-9]{1,16}.
# CRITERIA_SALARY_ACTIVE_KEY: o kid que cifra as gravações (a leitura aceita qualquer kid do anel).
# Gere cada chave localmente com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotação: acrescente a chave nova ao anel e torne-a a ativa; só retire a antiga depois de recifrar as linhas dela.
# Perder a chave torna a pretensão ilegível (a API responde 503, nunca "configure seus critérios").
CRITERIA_SALARY_KEYS=
CRITERIA_SALARY_ACTIVE_KEY=

# Upstash Redis (HITL-007, us-east-1). Token REST só no servidor; nunca na extensão.
# Obrigatórias (ADR-014 D8): sem elas a API não sobe. A URL é a origem https exata do banco (aba REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Pepper do HMAC das chaves de rate limit e de cota (ADR-014 D7: IP e sub nunca em claro no Redis). SEGREDO,
# obrigatório, base64url de pelo menos 32 bytes. Gere localmente com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RATE_KEY_PEPPER=
