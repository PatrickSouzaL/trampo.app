# Modelo do .env da API: só NOMES. Os valores ficam no .env local (fora do git e do cofre) e no
# gerenciador de senhas. Runbook: ../base/03-infra-runbook/llm.md

# Servidor
HOST=127.0.0.1
PORT=3001

# Borda (ADR-007). Vazio = falha fechado.
# CORS_ALLOWED_ORIGINS: lista exata separada por vírgula (chrome-extension://<id de 32 letras a-p>,
# https://<origem do portal>). Sem curinga, sem barra final. Vazio nega toda origem de navegador.
CORS_ALLOWED_ORIGINS=
# TRUST_PROXY: false, ou IPs/CIDRs dos saltos de proxy reais (definidos no S-5 / ADR-003).
# Recusados: true, *, /0 e contagem de saltos.
TRUST_PROXY=false
# API_BEHIND_PROXY (ADR-004 D8 item 4): true se a API roda atrás de proxy (Cloudflare, S-5), false se não. Lida no
# boot em falha fechada (F1-API-07 07g): obrigatória fora de NODE_ENV=test, só true ou false, e precisa concordar com o
# TRUST_PROXY (true exige os saltos do proxy; false exige TRUST_PROXY=false). Sem isso, o limitador local das rotas
# públicas de auth contaria todo mundo no IP do proxy. Na máquina local, sem proxy: API_BEHIND_PROXY=false.
API_BEHIND_PROXY=

# Cadeia de LLM das Fases 0 e 1 (HITL-012: Gemini fora da cadeia). Obrigatória: sem ela a API não sobe.
LLM_PROVIDER_CHAIN=groq,cloudflare_workers_ai

# Groq (ZDR ligado na organização ANTES da primeira chamada)
# Primário da cadeia (ADR-022). Obrigatória quando groq está na LLM_PROVIDER_CHAIN: sem ela a API não sobe.
# GROQ_API_KEY: gsk_ seguido de [A-Za-z0-9_-]{20,200}. O modelo (openai/gpt-oss-20b) e a URL são fixos no código.
GROQ_API_KEY=

# Cloudflare Workers AI (token personalizado só com Workers AI Read e Edit, com TTL)
# Fallback da cadeia (ADR-020). Obrigatórias quando cloudflare_workers_ai está na LLM_PROVIDER_CHAIN.
# CLOUDFLARE_ACCOUNT_ID: 32 hex minúsculos. CLOUDFLARE_API_TOKEN: [A-Za-z0-9_-]{40,200}.
# CLOUDFLARE_WORKERS_AI_MODEL: id @cf/...; vazia = o modelo medido no S-1 (@cf/meta/llama-3.3-70b-instruct-fp8-fast).
# Trocar de modelo exige passar pelo gate do golden dataset antes (T28).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL=

# Supabase (HITL-004, East US / us-east-1). A chave secret e a senha do banco ficam só no servidor.
# SUPABASE_URL e SUPABASE_JWKS_URL são obrigatórias (ADR-013 D6): sem elas a API não sobe. O JWKS precisa ser
# exatamente <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=
SUPABASE_JWKS_URL=
# Obrigatória (ADR-018 D5): o cliente de usuário do PostgREST usa SÓ a publishable (sb_publishable_...), com o JWT
# do próprio usuário, para a RLS valer. Chave secret (sb_secret_...) ou legada (eyJ...) aqui derruba a subida.
SUPABASE_PUBLISHABLE_KEY=
# Só o DeleteAccount (F1-PORTAL-03) a usará. Nunca na extensão, no portal ou no cliente de usuário.
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# Cifra da pretensão salarial no app (ADR-018 D4). SEGREDO, obrigatório: sem o anel a API não sobe. Fica só neste
# .env e no gerenciador de senhas; nunca no cofre, no git, no banco ou no Supabase Vault.
# CRITERIA_SALARY_KEYS: de 1 a 4 entradas <kid>:<32 bytes em base64url>, separadas por vírgula; kid em [a-z0-9]{1,16}.
# CRITERIA_SALARY_ACTIVE_KEY: o kid que cifra as gravações (a leitura aceita qualquer kid do anel).
# Gere cada chave localmente com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotação: acrescente a chave nova ao anel e torne-a a ativa; só retire a antiga depois de recifrar as linhas dela.
# Perder a chave torna a pretensão ilegível (a API responde 503, nunca "configure seus critérios").
CRITERIA_SALARY_KEYS=
CRITERIA_SALARY_ACTIVE_KEY=

# Sessão do BFF de autenticação da extensão (ADR-004 D5): o refresh do Supabase vai selado num envelope que só a API
# abre. Lidas no boot em falha fechada (F1-API-07 07g): anel inválido ou ausente, idade fora da faixa ou chave repetida
# entre este anel e o CRITERIA_SALARY_KEYS derrubam a subida, sem ecoar valor. Obrigatórias também na máquina local.
# AUTH_REFRESH_SEAL_KEYS: SEGREDO. De 1 a 4 entradas <kid>:<32 bytes em base64url>, separadas por vírgula; kid em
# [a-z0-9]{1,16}. Anel PRÓPRIO, nunca as chaves de CRITERIA_SALARY_KEYS. Fica só neste .env e no gerenciador de
# senhas; nunca no cofre, no git, no banco ou na extensão. Gere cada chave localmente com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# AUTH_REFRESH_SEAL_ACTIVE_KEY: o kid que sela (a abertura aceita qualquer kid do anel). Rotação: acrescente a chave
# nova e torne-a a ativa; retirar uma chave derruba as sessões seladas com ela (o usuário só entra de novo).
AUTH_REFRESH_SEAL_KEYS=
AUTH_REFRESH_SEAL_ACTIVE_KEY=
# Idade máxima da sessão, em segundos: vazia = 86400 (24 h); de 3600 a 604800.
# O hook do banco (F1-DB-02, ADR-026) também corta em 86400, fixo na migration: os dois limites valem e o menor ganha.
# Acima de 86400 esta variável não tem efeito depois que o hook estiver ligado no projeto (HITL-040).
AUTH_SESSION_MAX_AGE_SECONDS=
# Inatividade, em segundos: vazia = 14400 (4 h); de 900 até a idade máxima.
AUTH_SESSION_IDLE_SECONDS=
# Métodos de login aceitos no `amr` do JWT (ADR-004 D6), para TODA rota protegida: vazia = oauth (só login social).
# Lista separada por vírgula, sem espaço. `password` só com NODE_ENV=test (pilha local); fora disso a API não sobe.
AUTH_ALLOWED_AMR=

# Upstash Redis (HITL-007, us-east-1). Token REST só no servidor; nunca na extensão.
# Obrigatórias (ADR-014 D8): sem elas a API não sobe. A URL é a origem https exata do banco (aba REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Pepper do HMAC das chaves de rate limit e de cota (ADR-014 D7: IP e sub nunca em claro no Redis). SEGREDO,
# obrigatório, base64url de pelo menos 32 bytes. Gere localmente com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RATE_KEY_PEPPER=
